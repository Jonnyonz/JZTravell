# Configuración JZ Travel
PROJECT_NAME=JZ_Travel
PORT=8000

# Base de Datos
POSTGRES_USER=jzadmin
POSTGRES_PASSWORD=cambia_esto_por_una_clave_segura
POSTGRES_DB=jzflete_db

# OSRM (Mapas Offline) - URL de Geofabrik. Por defecto: Argentina
OSRM_REGION_URL=http://download.geofabrik.de/south-america/argentina-latest.osm.pbf

# Token de configuración inicial (se pide una sola vez, en la primera pantalla,
# para crear el usuario administrador). install.sh lo genera solo y lo muestra al terminar.
SETUP_TOKEN=se_genera_automaticamente_al_instalar
