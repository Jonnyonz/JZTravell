# Configuración JZ Travel
PROJECT_NAME=JZ_Travel

# Donde Docker publica la app (por http). El HTTPS lo pone el proxy del servidor: tiene que poder llegar a
# APP_BIND:PORT. install.sh usa 0.0.0.0 y 8010 (se cambian con JZTRAVELL_BIND y JZTRAVELL_PORT).
PORT=8000
APP_BIND=0.0.0.0

# Dominio publico con el que se entra. Lo guarda install.sh; la app no lo usa.
# JZTRAVELL_DOMAIN=fletes.empresa.com

# Base de Datos
POSTGRES_USER=jzadmin
POSTGRES_PASSWORD=cambia_esto_por_una_clave_segura
POSTGRES_DB=jzflete_db

# OSRM (ruteo por mapas) no se usa actualmente: la optimizacion de ruta se calcula con
# haversine en el backend. Se deja comentado por si se retoma el ruteo real mas adelante.
# OSRM_REGION_URL=http://download.geofabrik.de/south-america/argentina-latest.osm.pbf

# Token de configuración inicial (se pide una sola vez, en la primera pantalla,
# para crear el usuario administrador). install.sh lo genera solo y lo muestra al terminar.
SETUP_TOKEN=se_genera_automaticamente_al_instalar

# Proxies inversos de confianza (IPs o redes, separadas por coma). Solo desde ellos se cree
# el encabezado X-Forwarded-For para calcular la IP real en el rate limit de login.
# Por defecto: loopback y redes de Docker (un proxy en el mismo servidor). Si el proxy esta en otro
# equipo, agregar su IP (install.sh lo hace con JZTRAVELL_PROXY_IP=<IP>).
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
